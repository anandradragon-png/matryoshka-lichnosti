{
  "name": "matryoshka-lichnosti",
  "version": "1.0.0",
  "private": true,
  "description": "Прототип сайта «Матрёшка Личности» — сервис психологической поддержки",
  "type": "commonjs",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"js/**/*.js\" \"dars-data.js\" \"styles.css\" \"index.html\"",
    "format:check": "prettier --check \"js/**/*.js\" \"dars-data.js\" \"styles.css\" \"index.html\"",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3"
  }
}
